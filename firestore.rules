rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.userId == uid;
      match /{kind}/{recordId} {
        allow read: if owner(uid) && kind in ['diary','favorites','collections'];
        allow delete: if owner(uid) && kind in ['diary','favorites','collections'];
        allow create, update: if owner(uid)
          && kind in ['diary','favorites','collections']
          && request.resource.data.userId == uid
          && request.resource.data.id == recordId
          && request.resource.data.updatedAt is int
          && request.resource.data.revision is string
          && request.resource.data.synced == true
          && (kind != 'diary' || (
            request.resource.data.name is string
            && request.resource.data.eventDate is string
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5));
      }
    }
  }
}
